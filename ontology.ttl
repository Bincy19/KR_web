@prefix : <http://www.kr_paris.com/ontologies/tourism#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.kr_paris.com/ontologies/tourism#> .

<http://www.kr_paris.com/ontologies/tourism> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://dbpedia.org/ontology/capital
dbo:capital rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/countryCode
dbo:countryCode rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/currency
dbo:currency rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/description
dbo:description rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/image
dbo:image rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/includesCity
dbo:includesCity rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/includesStates
dbo:includesStates rdf:type owl:AnnotationProperty .


###  http://dbpedia.org/ontology/timeZone
dbo:timeZone rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/depiction
foaf:depiction rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/Attraction
dbo:Attraction rdf:type owl:Class .


###  http://dbpedia.org/ontology/City
dbo:City rdf:type owl:Class .


###  http://dbpedia.org/ontology/Country
dbo:Country rdf:type owl:Class .


###  http://dbpedia.org/ontology/CountryInfo
dbo:CountryInfo rdf:type owl:Class .


###  http://dbpedia.org/ontology/Destination
dbo:Destination rdf:type owl:Class .


###  http://dbpedia.org/ontology/Region
dbo:Region rdf:type owl:Class .


###  http://dbpedia.org/ontology/State
dbo:State rdf:type owl:Class .

#################################################################
# Object Properties
#################################################################

dbo:hasAttractionType rdf:type owl:ObjectProperty ;
    rdfs:domain dbo:Attraction ;
    rdfs:range owl:Class .

#################################################################
#    Individuals
#################################################################

:historical_cultural rdf:type owl:Class ;
    rdfs:subClassOf dbo:Attraction .

:events_festival rdf:type owl:Class ;
    rdfs:subClassOf dbo:Attraction .

:natural_attractions rdf:type owl:Class ;
    rdfs:subClassOf dbo:Attraction .

:city rdf:type owl:Class ;
    rdfs:subClassOf dbo:Attraction .

:museum rdf:type owl:Class ;
    rdfs:subClassOf dbo:Attraction .

